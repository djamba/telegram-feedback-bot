no-reply-error = This message is not a reply to any other message!

cannot-answer-to-user-error =
    Failed to deliver the message to the recipient!
    Telegram response: { $error }

cannot-get-user-info-error = Failed to retrieve user information. Error: { $error }

cannot-update-edited-error = Unfortunately, edits to this message won't be visible to the recipient. I recommend sending a new message instead.

cannot-reply-with-this-type-error = Sorry, this type of message is not supported for replies.

too-long-text-error = Unfortunately, this message exceeds the character limit. Please condense your thoughts and try again.

too-long-caption-error = Unfortunately, the media caption is too long. Please shorten your description and try again.

you-were-banned-error = Access restricted. The bot owner has blocked your account; messages will not be delivered.

unsupported-message-type-error = Sorry, this message type is not supported. Please try sending something else.
